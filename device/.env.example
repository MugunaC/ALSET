# device/.env.example
# IVY / gateway urls
API_URL=http://127.0.0.1:3100
DEVICE_WS=ws://127.0.0.1:4000
SIGNAL_URL=ws://127.0.0.1:3100/signal
TELEMETRY_URL=http://127.0.0.1:3100/api/input

# Device identity
VEHICLE_ID=VH-001
DEVICE_ID=PICO-VH-001
DEVICE_SHARED_SECRET=ivy-dev-device-secret

# GPS and ESP32
GPS_DEVICE=/dev/ttyS0
GPS_BAUD=9600
ESP32_SERIAL=/dev/ttyUSB0
ESP32_BAUD=115200

# camera
CAM_WIDTH=1280
CAM_HEIGHT=720
CAM_FPS=20

# Telemetry interval (seconds)
TELEMETRY_INTERVAL=1.0

# Debug
DEBUG=1
